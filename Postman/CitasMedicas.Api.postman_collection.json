{
  "info": {
    "name": "API de citas médicas",
    "description": "Pruebas funcionales de la API de citas médicas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5095"
    }
  ],
  "item": [
    {
      "name": "1. Registrar cita válida",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": 1,\n  \"medicoId\": 1,\n  \"fechaHoraInicio\": \"2030-12-10T09:00:00\",\n  \"duracionMinutos\": 30,\n  \"motivo\": \"Consulta de control\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/citas"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Devuelve 201', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('citaId', pm.response.json().id);"
          ]
        }
      }]
    },
    {
      "name": "2. Consultar todas las citas",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/citas" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "3. Consultar cita inexistente",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/citas/999" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve 404', function () { pm.response.to.have.status(404); });"] } }]
    },
    {
      "name": "4. Registrar cita con datos inválidos",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": 1,\n  \"medicoId\": 1,\n  \"fechaHoraInicio\": \"2030-12-10T11:00:00\",\n  \"duracionMinutos\": 5,\n  \"motivo\": \"\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/citas"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve 400', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "5. Registrar cita con horario superpuesto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": 2,\n  \"medicoId\": 1,\n  \"fechaHoraInicio\": \"2030-12-10T09:15:00\",\n  \"duracionMinutos\": 30,\n  \"motivo\": \"Control preventivo\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/citas"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve 409', function () { pm.response.to.have.status(409); });"] } }]
    },
    {
      "name": "6. Actualizar cita",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": 1,\n  \"medicoId\": 1,\n  \"fechaHoraInicio\": \"2030-12-10T10:00:00\",\n  \"duracionMinutos\": 30,\n  \"motivo\": \"Consulta actualizada\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/citas/{{citaId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve 204', function () { pm.response.to.have.status(204); });"] } }]
    },
    {
      "name": "7. Eliminar cita",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/citas/{{citaId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve 204', function () { pm.response.to.have.status(204); });"] } }]
    }
  ]
}
